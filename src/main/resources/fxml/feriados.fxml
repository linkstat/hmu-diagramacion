<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="480.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ar.com.hmu.controller.FeriadosController"
            stylesheets="@../css/diagramacionServicio.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10"/>
            </padding>
            <Label text="Feriados" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
            <Label text="Año:"/>
            <ComboBox fx:id="anioCombo" prefWidth="110"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button text="Refrescar" onAction="#onRefrescar"/>
            <Button text="Cerrar" onAction="#onCerrar" cancelButton="true"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="feriadosTable">
            <columns>
                <TableColumn fx:id="fechaCol" prefWidth="130" text="FECHA"/>
                <TableColumn fx:id="descripcionCol" prefWidth="320" text="DESCRIPCIÓN"/>
                <TableColumn fx:id="estadoCol" prefWidth="225" text="ESTADO"/>
            </columns>
            <BorderPane.margin>
                <Insets bottom="6" left="10" right="10"/>
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="6">
            <padding>
                <Insets bottom="10" left="10" right="10" top="4"/>
            </padding>
            <!-- La ayuda va en su propia línea: en la misma fila que los
                 botones les quitaba ancho y los truncaba ("Car…", "Prop…"). -->
            <Label fx:id="ayudaLabel" text="" styleClass="ayuda" wrapText="true"/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="cargaAnualButton" text="Carga anual…" onAction="#onCargaAnual"
                        minWidth="-Infinity" visible="false" managed="false"/>
                <Button fx:id="proponerAltaButton" text="Proponer alta…" onAction="#onProponerAlta"
                        minWidth="-Infinity" visible="false" managed="false"/>
                <Button fx:id="proponerBajaButton" text="Proponer baja" onAction="#onProponerBaja"
                        minWidth="-Infinity" visible="false" managed="false"/>
                <Button fx:id="rechazarButton" text="Rechazar" onAction="#onRechazar"
                        minWidth="-Infinity" visible="false" managed="false"/>
                <Button fx:id="autorizarButton" text="Autorizar" onAction="#onAutorizar"
                        minWidth="-Infinity" visible="false" managed="false"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
