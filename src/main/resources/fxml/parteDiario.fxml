<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1300.0" xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ar.com.hmu.controller.ParteDiarioController"
            stylesheets="@../css/novedades.css">
    <top>
        <VBox spacing="6">
            <padding>
                <Insets bottom="6" left="10" right="10" top="10"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Parte diario" styleClass="titulo-pantalla"/>
                <Label text="Fecha:" styleClass="subtitulo-perfil"/>
                <DatePicker fx:id="fechaPicker" prefWidth="130"/>
                <Label fx:id="fechaLargaLabel" style="-fx-font-weight: bold;"/>
                <Label fx:id="estadoChip" styleClass="estado-chip" visible="false"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="importarButton" text="Importar marcaciones…" onAction="#onImportar"/>
                <Button fx:id="generarButton" text="Generar parte" onAction="#onGenerar"/>
                <Button text="Cerrar" onAction="#onSalir" cancelButton="true"/>
            </HBox>
            <HBox fx:id="loteBox" alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color: #f4f6f7; -fx-border-color: #d5d8dc; -fx-padding: 5 8 5 8;">
                <Label text="Último lote:" style="-fx-font-weight: bold;"/>
                <Label fx:id="loteLabel"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Cotejo por agente" styleClass="seccion-titulo"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label text="Vinculación:"/>
                <ComboBox fx:id="vinculacionCombo" prefWidth="220"/>
                <Label text="Servicio:"/>
                <ComboBox fx:id="servicioCombo" prefWidth="200"/>
                <CheckBox fx:id="soloDiferenciasCheck" text="Sólo diferencias sin justificar"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="4">
            <padding>
                <Insets left="10" right="10"/>
            </padding>
            <TableView fx:id="detallesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="agenteCol" prefWidth="160" text="AGENTE"/>
                    <TableColumn fx:id="servicioCol" prefWidth="160" text="SERVICIO"/>
                    <TableColumn text="JORNADA">
                        <columns>
                            <TableColumn fx:id="diagramadaCol" prefWidth="120" text="DIAGRAMADA"/>
                            <TableColumn fx:id="registradaCol" prefWidth="130" text="REGISTRADA"/>
                        </columns>
                    </TableColumn>
                    <TableColumn fx:id="diferenciaCol" prefWidth="85" text="DIFERENCIA"/>
                    <TableColumn fx:id="siglaCol" prefWidth="55" text="SIGLA"/>
                    <TableColumn fx:id="codigoCol" prefWidth="65" text="CÓD. CH"/>
                    <TableColumn fx:id="origenCol" prefWidth="120" text="ORIGEN"/>
                    <TableColumn fx:id="observacionCol" prefWidth="380" text="OBSERVACIÓN"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="contadorLabel" styleClass="pie-contador"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="BOTTOM_LEFT" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="6"/>
            </padding>
            <VBox fx:id="cargaBox" spacing="6"
                  style="-fx-border-color: #d5d8dc; -fx-border-radius: 3; -fx-padding: 6 10 8 10;">
                <Label text="Carga manual" style="-fx-font-weight: bold;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Agente:" minWidth="80"/>
                    <ComboBox fx:id="cargaAgenteCombo" prefWidth="210" promptText="Seleccionar agente…"/>
                    <Label text="Código:"/>
                    <ComboBox fx:id="cargaCodigoCombo" prefWidth="220" promptText="Seleccionar código…"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Observación *:" minWidth="80"/>
                    <TextField fx:id="cargaObservacionField" prefWidth="380"
                               promptText="Obligatoria: motivo y respaldo de la carga"/>
                    <Button fx:id="registrarCargaButton" text="Registrar carga" onAction="#onRegistrarCarga"/>
                </HBox>
            </VBox>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="justificacionButton" text="Solicitar justificación" onAction="#onSolicitarJustificacion"/>
            <Button fx:id="cerrarParteButton" text="Cerrar parte" onAction="#onCerrarParte"/>
        </HBox>
    </bottom>
</BorderPane>
