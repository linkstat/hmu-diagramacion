<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ar.com.hmu.controller.NovedadesController"
            stylesheets="@../css/novedades.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets bottom="8" left="10" right="10" top="10"/>
            </padding>
            <Label text="Novedades" styleClass="titulo-pantalla"/>
            <Label fx:id="perfilLabel" styleClass="subtitulo-perfil"/>
            <ComboBox fx:id="perfilCombo" visible="false" managed="false"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Estado:"/>
            <ComboBox fx:id="estadoFiltroCombo" prefWidth="170"/>
            <Label text="Agente:"/>
            <TextField fx:id="agenteFiltroField" promptText="Buscar por apellido…" prefWidth="170"/>
            <Button text="Refrescar" onAction="#onRefrescar"/>
            <Button text="Cerrar" onAction="#onCerrar" cancelButton="true"/>
        </HBox>
    </top>
    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.47">
            <BorderPane.margin>
                <Insets left="10" right="10"/>
            </BorderPane.margin>
            <VBox spacing="4">
                <TableView fx:id="novedadesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="agenteCol" prefWidth="140" text="AGENTE"/>
                        <TableColumn fx:id="tipoCol" prefWidth="160" text="TIPO"/>
                        <TableColumn fx:id="desdeCol" prefWidth="82" text="DESDE"/>
                        <TableColumn fx:id="hastaCol" prefWidth="82" text="HASTA"/>
                        <TableColumn fx:id="estadoCol" prefWidth="104" text="ESTADO"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
                <Label fx:id="contadorLabel" styleClass="pie-contador">
                    <padding>
                        <Insets bottom="2" left="2"/>
                    </padding>
                </Label>
            </VBox>
            <VBox fx:id="detalleBox" spacing="8">
                <padding>
                    <Insets left="8" right="4" top="2"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="detalleTituloLabel" styleClass="detalle-titulo"
                           text="Seleccione una novedad"/>
                    <Label fx:id="detalleEstadoChip" styleClass="estado-chip" visible="false"/>
                </HBox>
                <ScrollPane fitToWidth="true" prefHeight="190" minHeight="120" style="-fx-background-color: transparent;">
                    <GridPane fx:id="detalleGrid" hgap="10" vgap="3">
                        <columnConstraints>
                            <ColumnConstraints minWidth="128" prefWidth="128"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                    </GridPane>
                </ScrollPane>
                <Label text="Historial de instancias" styleClass="seccion-titulo"/>
                <TableView fx:id="historialTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="instanciaCol" prefWidth="110" text="INSTANCIA"/>
                        <TableColumn fx:id="usuarioCol" prefWidth="120" text="USUARIO"/>
                        <TableColumn fx:id="fechaHoraCol" prefWidth="100" text="FECHA Y HORA"/>
                        <TableColumn fx:id="resultadoCol" prefWidth="90" text="RESULTADO"/>
                        <TableColumn fx:id="comentarioCol" prefWidth="200" text="COMENTARIO"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding>
                <Insets bottom="10" left="10" right="10" top="6"/>
            </padding>
            <Label fx:id="ayudaLabel" styleClass="ayuda"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="licenciaButton" text="Registrar licencia externa…" onAction="#onLicencia"/>
            <Button fx:id="nuevaButton" text="Nueva solicitud…" onAction="#onNueva"/>
            <Button fx:id="corregirButton" text="Corregir y reenviar…" onAction="#onCorregir"/>
            <Button fx:id="anularButton" text="Anular" onAction="#onAnular"/>
            <Button fx:id="secretariaButton" text="Registrar resultado de la Secretaría de Salud…"
                    onAction="#onSecretaria"/>
            <Button fx:id="autorizarButton" text="Autorizar" onAction="#onAutorizar" defaultButton="true"/>
            <Button fx:id="devolverButton" text="Devolver para corrección" onAction="#onDevolver"/>
            <Button fx:id="rechazarButton" text="Rechazar" onAction="#onRechazar"/>
        </HBox>
    </bottom>
</BorderPane>
