<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>

<BorderPane prefHeight="600.0" prefWidth="520.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ar.com.hmu.controller.AbmServicioController">
    <center>
        <VBox prefHeight="600.0" prefWidth="500.0" spacing="10">
            <TableView fx:id="serviciosTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nombreColumn" minWidth="20.0" prefWidth="200.0" text="NOMBRE DE SERVICIO" />
               <TableColumn fx:id="agrupacionColumn" minWidth="15.0" prefWidth="130.0" text="AGRUPACIÓN" />
               <TableColumn fx:id="dotacionColumn" minWidth="15.0" prefWidth="80.0" text="DOTACIÓN" />
                </columns>
            </TableView>
         <HBox alignment="TOP_CENTER" spacing="10">
            <children>
                   <TextField fx:id="nombreTextField" minWidth="20.0" prefWidth="192.0" promptText="Nombre del Servicio" />
               <ComboBox fx:id="agrupacionComboBox" minWidth="15.0" prefWidth="143.0" />
            </children>
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label text="Dotación mínima:" minWidth="-Infinity" />
                <TextField fx:id="dotacionTextField" minWidth="60.0" prefWidth="60.0" promptText="—" />
                <Label text="agentes (franjas: regla RV-DOTACION-MIN)" minWidth="10.0" style="-fx-text-fill: #5d6d7e; -fx-font-size: 11;" />
            </children>
         </HBox>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <children>
                <Label text="Encargado actual:" />
                <ComboBox fx:id="encargadoComboBox" minWidth="15.0" prefWidth="270.0" promptText="(seleccionar un servicio)" />
            </children>
         </HBox>
            <HBox alignment="BOTTOM_RIGHT" spacing="10">
                <Button onAction="#onAgregarServicio" text="Agregar" />
                <Button onAction="#onModificarServicio" text="Modificar" />
                <Button onAction="#onEliminarServicio" text="Eliminar" />
            </HBox>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
        </VBox>
    </center>
</BorderPane>
